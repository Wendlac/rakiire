---
/**
 * Design system Rakiire — documentation vivante.
 *
 * Cette page n'est pas une maquette : elle importe les composants réels et les
 * tokens réels. Si un token change, la page change. Elle sert donc autant de
 * référence que de test de non-régression visuelle.
 */
import Base from "../layouts/Base.astro";
import SectionDoc from "../components/doc/SectionDoc.astro";
import Bloc from "../components/doc/Bloc.astro";

import Logo from "../components/ui/Logo.astro";
import Symbole from "../components/ui/Symbole.astro";
import Bouton from "../components/ui/Bouton.astro";
import Pastille from "../components/ui/Pastille.astro";
import Champ from "../components/ui/Champ.astro";
import SelecteurTaille from "../components/ui/SelecteurTaille.astro";
import SelecteurCouleur from "../components/ui/SelecteurCouleur.astro";
import Quantite from "../components/ui/Quantite.astro";
import Alerte from "../components/ui/Alerte.astro";
import Prix from "../components/ui/Prix.astro";
import CarteProduit from "../components/ui/CarteProduit.astro";
import Heros from "../components/ui/Heros.astro";
import MarqueGeante from "../components/ui/MarqueGeante.astro";
import GrilleProduits from "../components/ui/GrilleProduits.astro";
import BarreFiltres from "../components/ui/BarreFiltres.astro";
import SelecteurLangue from "../components/ui/SelecteurLangue.astro";

import { composerMessage, NUMERO_AFFICHE } from "../lib/whatsapp";

/* Nuancier produit d'exemple. Le noir et le blanc sont les deux seules couleurs
   au catalogue ; les autres illustrent le comportement du compteur de dépassement. */
const couleursDemo = [
  { nom: "Noir", valeur: "#080F0F" },
  { nom: "Blanc", valeur: "#FFFFFF" },
  { nom: "Sauge", valeur: "#A4BAB7" },
  { nom: "Citron", valeur: "#EFF2C0" },
  { nom: "Orange", valeur: "#FD5200" },
  { nom: "Encre claire", valeur: "#4D5252" },
];

/* -- Données de documentation ---------------------------------------------- */

const couleursMarque = [
  { nom: "encre", hex: "#080F0F", contraste: "16.67", role: "Texte, surfaces sombres, anneau de focus" },
  { nom: "fond", hex: "#EEEEEE", contraste: "—", role: "Fond de toutes les pages" },
  { nom: "sauge", hex: "#A4BAB7", contraste: "1.76", role: "Surface pleine uniquement, jamais un texte ni un filet" },
  { nom: "orange", hex: "#FD5200", contraste: "2.84", role: "Surface d’action, avec texte encre par-dessus" },
  { nom: "citron", hex: "#EFF2C0", contraste: "1.00", role: "Lavis de section, sans rôle hiérarchique" },
];

const rampe = [
  { nom: "encre-08", hex: "#DCDCDC", contraste: "1.18", usage: "Filet décoratif" },
  { nom: "encre-12", hex: "#D2D3D3", contraste: "1.29", usage: "Séparateur" },
  { nom: "encre-16", hex: "#C9CACA", contraste: "1.41", usage: "Contour de carte" },
  { nom: "encre-24", hex: "#B7B8B8", contraste: "1.71", usage: "Filet décoratif" },
  { nom: "encre-32", hex: "#A4A7A7", contraste: "2.09", usage: "Filet décoratif" },
  { nom: "encre-45", hex: "#878A8A", contraste: "3.02", usage: "Bordure et icône — seuil AA" },
  { nom: "encre-55", hex: "#6F7373", contraste: "4.11", usage: "Bordure et icône" },
  { nom: "encre-62", hex: "#5F6464", contraste: "5.19", usage: "Texte tertiaire — seuil AA" },
  { nom: "encre-70", hex: "#4D5252", contraste: "6.85", usage: "Texte secondaire" },
  { nom: "encre-80", hex: "#363C3C", contraste: "9.74", usage: "Texte AAA" },
  { nom: "encre-90", hex: "#1F2525", contraste: "13.37", usage: "Texte AAA" },
];

const fonctionnelles = [
  { nom: "erreur", hex: "#A32100", contraste: "6.52", usage: "Texte et surface d’erreur" },
  { nom: "succes", hex: "#2F5D50", contraste: "6.46", usage: "Texte et surface de confirmation" },
];

const echelle = [
  { jeton: "affiche", classe: "text-affiche", taille: "52 → 144 px", usage: "Titre de couverture, une fois par page au maximum" },
  { jeton: "t1", classe: "text-t1", taille: "40 → 88 px", usage: "Titre de page" },
  { jeton: "t2", classe: "text-t2", taille: "32 → 60 px", usage: "Titre de section" },
  { jeton: "t3", classe: "text-t3", taille: "24 → 38 px", usage: "Sous-section" },
  { jeton: "t4", classe: "text-t4", taille: "20 → 26 px", usage: "Titre de fiche" },
  { jeton: "t5", classe: "text-t5", taille: "18 px", usage: "Nom de produit en grille" },
];

const echelleCorps = [
  { jeton: "corps-l", classe: "text-corps-l", taille: "18 px", usage: "Chapeau éditorial" },
  { jeton: "corps", classe: "text-corps", taille: "16 px", usage: "Texte courant" },
  { jeton: "corps-s", classe: "text-corps-s", taille: "14 px", usage: "Aide, note, récapitulatif" },
  { jeton: "legende", classe: "text-legende", taille: "12 px", usage: "Référence produit, mention légale" },
  { jeton: "surtitre", classe: "text-surtitre", taille: "11 px", usage: "Étiquette de section, libellé de champ" },
];

const espacements = [
  { jeton: "1", px: "4 px" },
  { jeton: "2", px: "8 px" },
  { jeton: "3", px: "12 px" },
  { jeton: "4", px: "16 px" },
  { jeton: "6", px: "24 px" },
  { jeton: "8", px: "32 px" },
  { jeton: "12", px: "48 px" },
  { jeton: "16", px: "64 px" },
  { jeton: "24", px: "96 px" },
  { jeton: "32", px: "128 px" },
];

const mouvements = [
  { jeton: "duree-rapide", valeur: "160 ms", usage: "Survol, changement d’état immédiat" },
  { jeton: "duree-normale", valeur: "280 ms", usage: "Couleur, bordure, bascule de bouton" },
  { jeton: "duree-lente", valeur: "480 ms", usage: "Échelle d’image, ouverture de panneau" },
  { jeton: "duree-reveal", valeur: "900 ms", usage: "Apparition au défilement" },
];

/* Exemple réel de message de commande, généré par le même code que le site. */
const messageExemple = composerMessage(
  [
    {
      reference: "RKR-CLS-001-NR-L",
      nom: "Tee-shirt Nasara",
      couleur: "NR",
      taille: "L",
      prixUnitaire: 15000,
      quantite: 2,
    },
    {
      reference: "RKR-CLS-002-BL-M",
      nom: "Tee-shirt Wendé",
      couleur: "BL",
      taille: "M",
      prixUnitaire: 12000,
      quantite: 1,
    },
  ],
  { nom: "Aminata Sawadogo", ville: "Ouagadougou" },
  "fr",
);

const sommaire = [
  { id: "logo", label: "Logo" },
  { id: "couleurs", label: "Couleurs" },
  { id: "typographie", label: "Typographie" },
  { id: "espace", label: "Espace et grille" },
  { id: "matiere", label: "Matière et mouvement" },
  { id: "composants", label: "Composants" },
  { id: "motifs", label: "Motifs de page" },
  { id: "commande", label: "Commande" },
  { id: "accessibilite", label: "Accessibilité" },
];
---

<Base titre="Design system — Rakiire" description="Fondations, composants et règles d’usage du site Rakiire.">
  <header class="entete">
    <div class="cadre entete__cadre">
      <Logo hauteur="1.125rem" titre="Rakiire" />
      <nav class="entete__nav" aria-label="Sommaire">
        {sommaire.map((item) => <a class="entete__lien" href={`#${item.id}`}>{item.label}</a>)}
      </nav>
    </div>
  </header>

  <main id="contenu">
    <!-- Couverture ------------------------------------------------------- -->
    <div class="cadre">
      <div class="couverture">
        <p class="surtitre">Version 1.0 — Septembre 2026</p>
        <h1 class="couverture__titre">Design&nbsp;system</h1>
        <p class="couverture__chapeau mesure">
          Les fondations visuelles du site Rakiire, dérivées de la charte de marque
          et vérifiées une à une contre le niveau AA des règles d’accessibilité.
          Cette page importe les composants réels : ce que vous voyez est ce que
          le site produit.
        </p>
        <p class="couverture__principe">
          L’interface se tait pour que le vêtement parle.
        </p>
      </div>
    </div>

    <div class="cadre">
      <!-- 01 Logo -------------------------------------------------------- -->
      <SectionDoc
        numero="01"
        id="logo"
        titre="Logo"
        chapeau="Le logotype est recadré sur son propre tracé. Il ne se dimensionne que par sa hauteur et hérite de la couleur du texte environnant, ce qui le rend utilisable sur fond clair comme sur fond encre sans fichier supplémentaire."
      >
        <Bloc titre="Logotype" note="Hauteur minimale à l’écran : 16 px. En dessous, les branches des deux i se referment et la marque devient illisible.">
          <div class="rangee-logo">
            <Logo hauteur="1rem" titre="" />
            <Logo hauteur="1.5rem" titre="" />
            <Logo hauteur="2.5rem" titre="" />
            <Logo hauteur="4rem" titre="Rakiire" />
          </div>
        </Bloc>

        <Bloc titre="Sur fond encre" inverse note="Aucune version alternative n’est nécessaire : le tracé suit la couleur du texte.">
          <Logo hauteur="2.5rem" titre="" />
        </Bloc>

        <Bloc titre="Symbole" note="Les deux branches extraites du logotype. Réservé au favicon, à l’avatar social et au filigrane. Ne remplace jamais le logotype dans un en-tête.">
          <div class="rangee-logo">
            <Symbole hauteur="1.5rem" />
            <Symbole hauteur="2.5rem" />
            <Symbole hauteur="4rem" titre="Symbole Rakiire" />
          </div>
        </Bloc>
      </SectionDoc>

      <!-- 02 Couleurs ---------------------------------------------------- -->
      <SectionDoc
        numero="02"
        id="couleurs"
        titre="Couleurs"
        chapeau="Cinq couleurs de marque, une rampe de neutres dérivée de l’encre, deux couleurs fonctionnelles. Chaque valeur porte son contraste mesuré sur le fond de marque, et l’usage que ce contraste autorise."
      >
        <Bloc titre="Couleurs de marque" note="Issues de la charte. Le chiffre est le contraste mesuré sur le fond #EEEEEE.">
          <div class="nuancier">
            {
              couleursMarque.map((c) => (
                <div class="nuance">
                  <div class="nuance__aplat" style={`background-color:${c.hex}`} />
                  <p class="nuance__nom">{c.nom}</p>
                  <p class="nuance__hex chiffres-tabulaires">{c.hex}</p>
                  <p class="nuance__ratio chiffres-tabulaires">{c.contraste}</p>
                  <p class="nuance__role">{c.role}</p>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Rampe de neutres" note="Extension. Chaque valeur est un mélange d’encre sur le fond, donc strictement dans la teinte de la marque. Le seuil de 3.02 est le plancher d’une bordure, celui de 5.19 le plancher d’un texte.">
          <div class="rampe">
            {
              rampe.map((c) => (
                <div class="rampe__ligne">
                  <span class="rampe__aplat" style={`background-color:${c.hex}`} />
                  <span class="rampe__nom">{c.nom}</span>
                  <span class="rampe__hex chiffres-tabulaires">{c.hex}</span>
                  <span class="rampe__ratio chiffres-tabulaires">{c.contraste}</span>
                  <span class="rampe__usage">{c.usage}</span>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Couleurs fonctionnelles" note="Extension. Absentes de la charte mais indispensables à la validation du formulaire de commande. Choisies comme parents sombres de l’orange et de la sauge.">
          <div class="rampe">
            {
              fonctionnelles.map((c) => (
                <div class="rampe__ligne">
                  <span class="rampe__aplat" style={`background-color:${c.hex}`} />
                  <span class="rampe__nom">{c.nom}</span>
                  <span class="rampe__hex chiffres-tabulaires">{c.hex}</span>
                  <span class="rampe__ratio chiffres-tabulaires">{c.contraste}</span>
                  <span class="rampe__usage">{c.usage}</span>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Trois interdits" note="Ils ne relèvent pas du goût mais de la mesure.">
          <ul class="interdits">
            <li class="interdit">
              <span class="interdit__demo interdit__demo--a">Texte sauge</span>
              <p>Sauge sur fond : <strong>1.76</strong>. Sous le seuil de 3.0 exigé pour un simple filet. La sauge ne peut être qu’une surface pleine, avec de l’encre par-dessus.</p>
            </li>
            <li class="interdit">
              <span class="interdit__demo interdit__demo--b">Blanc sur orange</span>
              <p>Blanc sur orange : <strong>3.29</strong>. Insuffisant pour un texte courant. Sur l’orange, le texte est toujours encre, mesuré à 5.88.</p>
            </li>
            <li class="interdit">
              <span class="interdit__demo interdit__demo--c">Focus orange</span>
              <p>Orange sur fond : <strong>2.84</strong>. Il manque 0.16 pour un anneau de focus conforme. Le focus est donc encre, à 16.67.</p>
            </li>
          </ul>
        </Bloc>
      </SectionDoc>

      <!-- 03 Typographie -------------------------------------------------- -->
      <SectionDoc
        numero="03"
        id="typographie"
        titre="Typographie"
        chapeau="Goudy Bookletter 1911 pour les titres, Satoshi pour le contenu. La serif n’existe qu’en un seul poids romain : la hiérarchie se joue sur la taille, l’interlettrage et le blanc, jamais sur la graisse."
      >
        <Bloc titre="Les deux familles">
          <div class="familles">
            <div class="famille">
              <p class="surtitre">Titres</p>
              <p class="famille__specimen famille__specimen--titre">Le choix d’être soi</p>
              <p class="famille__meta">Goudy Bookletter 1911 — 400 romain, poids unique</p>
            </div>
            <div class="famille">
              <p class="surtitre">Contenu</p>
              <p class="famille__specimen famille__specimen--corps">Le choix d’être soi</p>
              <p class="famille__meta">Satoshi — 300 à 900, auto-hébergée</p>
            </div>
          </div>
        </Bloc>

        <Bloc titre="Échelle des titres" note="Fluide entre 375 et 1440 px de large. Un seul « affiche » par page.">
          <div class="echelle">
            {
              echelle.map((e) => (
                <div class="echelle__ligne">
                  <div class="echelle__meta">
                    <span class="echelle__jeton">{e.jeton}</span>
                    <span class="echelle__taille chiffres-tabulaires">{e.taille}</span>
                    <span class="echelle__usage">{e.usage}</span>
                  </div>
                  <p class={`echelle__specimen ${e.classe}`}>Rakiire</p>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Échelle de contenu">
          <div class="echelle">
            {
              echelleCorps.map((e) => (
                <div class="echelle__ligne">
                  <div class="echelle__meta">
                    <span class="echelle__jeton">{e.jeton}</span>
                    <span class="echelle__taille chiffres-tabulaires">{e.taille}</span>
                    <span class="echelle__usage">{e.usage}</span>
                  </div>
                  <p class={`echelle__specimen echelle__specimen--corps ${e.classe}`}>
                    Des vêtements pour celles et ceux qui choisissent d’être eux-mêmes.
                  </p>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Mesure de lecture" note="Un paragraphe ne dépasse jamais 38 rem, soit environ 68 signes. Au-delà, l’œil perd la ligne suivante au retour chariot.">
          <p class="mesure demo-mesure">
            Rakiire naît d’une idée simple : un vêtement ne dit pas d’où l’on vient,
            il dit qui l’on choisit d’être. Chaque pièce est pensée pour durer une
            saison de plus que la mode qui l’a vue naître.
          </p>
        </Bloc>
      </SectionDoc>

      <!-- 04 Espace ------------------------------------------------------- -->
      <SectionDoc
        numero="04"
        id="espace"
        titre="Espace et grille"
        chapeau="Base de 4 px. Les respirations de section sont fluides : elles s’ouvrent avec la largeur de l’écran, parce que le vide est la matière première du luxe silencieux."
      >
        <Bloc titre="Échelle d’espacement">
          <div class="espaces">
            {
              espacements.map((e) => (
                <div class="espace">
                  <span class="espace__barre" style={`width:calc(var(--spacing) * ${e.jeton})`} />
                  <span class="espace__jeton chiffres-tabulaires">{e.jeton}</span>
                  <span class="espace__px chiffres-tabulaires">{e.px}</span>
                </div>
              ))
            }
          </div>
        </Bloc>

        <Bloc titre="Respirations fluides" note="Ces trois valeurs portent tout le rythme vertical du site.">
          <dl class="fluides">
            <div class="fluide">
              <dt>section</dt>
              <dd>80 → 176 px</dd>
              <dd class="fluide__note">Entre deux sections majeures</dd>
            </div>
            <div class="fluide">
              <dt>section-serrée</dt>
              <dd>48 → 96 px</dd>
              <dd class="fluide__note">Entre deux blocs d’une même section</dd>
            </div>
            <div class="fluide">
              <dt>gouttière</dt>
              <dd>20 → 56 px</dd>
              <dd class="fluide__note">Marge latérale de toute page</dd>
            </div>
          </dl>
        </Bloc>

        <Bloc titre="Largeurs" note="Le cadre plafonne à 1440 px. La mesure de lecture est indépendante et bien plus étroite.">
          <dl class="fluides">
            <div class="fluide"><dt>cadre</dt><dd>1440 px</dd><dd class="fluide__note">Largeur maximale du site</dd></div>
            <div class="fluide"><dt>étroit</dt><dd>832 px</dd><dd class="fluide__note">Page éditoriale</dd></div>
            <div class="fluide"><dt>lecture</dt><dd>608 px</dd><dd class="fluide__note">Paragraphe courant</dd></div>
          </dl>
        </Bloc>
      </SectionDoc>

      <!-- 05 Matière ------------------------------------------------------ -->
      <SectionDoc
        numero="05"
        id="matiere"
        titre="Matière et mouvement"
        chapeau="Angles vifs, ombres rares, décélérations franches. Une ombre est un aveu de faiblesse hiérarchique : on préfère le filet et le vide."
      >
        <Bloc titre="Rayons" note="Zéro est la règle. Le rayon pilule est réservé au compteur du panier.">
          <div class="rayons">
            <div class="rayon"><span class="rayon__forme" style="border-radius:0" /><span>nul — 0 px</span></div>
            <div class="rayon"><span class="rayon__forme" style="border-radius:2px" /><span>xs — 2 px</span></div>
            <div class="rayon"><span class="rayon__forme" style="border-radius:4px" /><span>sm — 4 px</span></div>
            <div class="rayon"><span class="rayon__forme" style="border-radius:999px" /><span>pilule</span></div>
          </div>
        </Bloc>

        <Bloc titre="Ombres" note="Deux seulement, pour les couches réellement flottantes : le panneau du panier et la fenêtre de repli WhatsApp.">
          <div class="ombres">
            <div class="ombre" style="box-shadow:var(--shadow-tenue)">ténue</div>
            <div class="ombre" style="box-shadow:var(--shadow-flottante)">flottante</div>
          </div>
        </Bloc>

        <Bloc titre="Durées" note="Toutes les transitions sont neutralisées si le système signale une préférence de mouvement réduit.">
          <div class="rampe">
            {
              mouvements.map((m) => (
                <div class="rampe__ligne">
                  <span class="rampe__nom">{m.jeton}</span>
                  <span class="rampe__hex chiffres-tabulaires">{m.valeur}</span>
                  <span class="rampe__usage">{m.usage}</span>
                </div>
              ))
            }
          </div>
        </Bloc>
      </SectionDoc>

      <!-- 06 Composants --------------------------------------------------- -->
      <SectionDoc
        numero="06"
        id="composants"
        titre="Composants"
        chapeau="Chaque composant est rendu ici dans ses états réels, y compris ceux qu’on oublie de maquetter : désactivé, épuisé, en erreur."
      >
        <Bloc titre="Boutons — variantes">
          <Bouton variante="primaire">Ajouter au panier</Bouton>
          <Bouton variante="accent">Commander sur WhatsApp</Bouton>
          <Bouton variante="contour">Voir la collection</Bouton>
          <Bouton variante="discret">Guide des tailles</Bouton>
        </Bloc>

        <Bloc titre="Boutons — tailles" note="Plancher de 44 px en hauteur, y compris en taille petite : la clientèle est massivement mobile.">
          <Bouton variante="primaire" taille="s">Petit</Bouton>
          <Bouton variante="primaire" taille="m">Moyen</Bouton>
          <Bouton variante="primaire" taille="l">Grand</Bouton>
        </Bloc>

        <Bloc titre="Boutons — désactivé">
          <Bouton variante="primaire" desactive>Indisponible</Bouton>
          <Bouton variante="accent" desactive>Panier vide</Bouton>
          <Bouton variante="contour" desactive>Bientôt</Bouton>
        </Bloc>

        <Bloc titre="Boutons sur aire sombre" inverse note="L’aire porte la classe .sur-sombre : les boutons s’inversent seuls. Aucune variante supplémentaire, aucune propriété à passer, donc aucun oubli possible dans un pied de page encre.">
          <Bouton variante="primaire">Ajouter au panier</Bouton>
          <Bouton variante="accent">Commander</Bouton>
          <Bouton variante="contour">Voir la collection</Bouton>
          <Bouton variante="discret">Guide des tailles</Bouton>
        </Bloc>

        <Bloc titre="Pastilles">
          <Pastille variante="neutre">Ethnic Classic</Pastille>
          <Pastille variante="inverse">Nouveau</Pastille>
          <Pastille variante="accent">Dernière pièce</Pastille>
          <Pastille variante="epuise">Épuisé</Pastille>
          <Pastille variante="inverse" forme="pilule">3</Pastille>
        </Bloc>

        <Bloc titre="Champs de formulaire" note="Le libellé reste toujours visible. Aucun texte indicatif ne sert d’étiquette.">
          <div class="colonne-formulaire">
            <Champ id="doc-nom" nom="nom" libelle="Nom complet" requis autocomplete="name" placeholder="Aminata Sawadogo" />
            <Champ id="doc-ville" nom="ville" libelle="Ville de livraison" aide="Ouagadougou, Bobo-Dioulasso, Abidjan…" requis />
            <Champ id="doc-err" nom="err" libelle="Ville de livraison" erreur="Merci d’indiquer votre ville pour estimer la livraison." requis />
          </div>
        </Bloc>

