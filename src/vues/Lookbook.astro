---
/**
 * Lookbook — Rakiire
 *
 * Une page de photographies, donc une page qui n'existe pas encore vraiment :
 * tant que le shooting n'a pas eu lieu, elle montre la composition et rien
 * d'autre. Elle est livrée maintenant pour deux raisons : le lien figure déjà
 * dans la navigation, et le photographe doit connaître les cadrages attendus
 * avant la prise de vue, pas après.
 *
 * Le rythme alterne volontairement : pleine largeur, puis deux colonnes, puis
 * un portrait décalé. Une grille régulière transformerait un lookbook en
 * catalogue — or le catalogue existe déjà, c'est la boutique.
 *
 * Chaque bloc porte le format attendu. C'est le brief du shooting.
 */
import Page from "../layouts/Page.astro";
import EnteteEditoriale from "../components/ui/EnteteEditoriale.astro";
import Bouton from "../components/ui/Bouton.astro";
import Revele from "../components/ui/Revele.astro";

import type { Langue } from "../lib/catalogue";
import { traduire, lienBoutique } from "../lib/i18n";

/* Photographies de la marque. Le `format` de chaque plan suit le rapport reel
   du fichier : demander un 21/9 a un portrait studio reviendrait a decapiter
   le mannequin pour tenir une maquette. */
import { Image } from "astro:assets";
import ouverture from "../images/lookbook/lookbook-01.jpg";
import planNoir from "../images/boutique/bissa-gurunsi-fusion.jpg";
import planBlanc from "../images/boutique/mossi-samo-classic.jpg";
import detail from "../images/boutique/mossi-samo-fusion.jpg";
import cloture from "../images/lookbook/lookbook-04.webp";

interface Props {
  langue: Langue;
  chemin: string;
}

const { langue, chemin } = Astro.props;
const t = traduire(langue);
const fr = langue === "fr";

/**
 * Plans du lookbook. `format` est le rapport de cadrage de la photographie,
 * `note` la légende éditoriale affichée sous l'image.
 */
const plans = [
  {
    disposition: "large",
    fichier: ouverture,
    alt: fr
      ? "Mannequin femme assise au sol, en tee-shirt clair et jean, fond orange"
      : "Female model seated on the floor in a light T-shirt and jeans, orange background",
    format: "3 / 2",
    titre: fr ? "Ouverture" : "Opening",
    note: fr ? "Plan au sol, fond orange." : "Floor-level shot, orange background.",
  },
  {
    disposition: "paire",
    fichier: planNoir,
    alt: fr
      ? "Tee-shirt noir à panneaux de jean, illustration de deux femmes, porté par un mannequin homme sur fond orange"
      : "Black T-shirt with denim panels and an illustration of two women, worn by a male model against an orange background",
    format: "2 / 3",
    titre: fr ? "Le noir" : "The black" ,
    note: fr ? "Plan taille, panneaux de jean apparents." : "Waist-up, denim panels in full view.",
  },
  {
    disposition: "paire",
    fichier: planBlanc,
    alt: fr
      ? "Tee-shirt blanc à l’empiècement de jean peint, mannequin femme assise en tailleur, fond gris"
      : "White T-shirt with a painted denim yoke, female model sitting cross-legged, grey background",
    format: "2 / 3",
    titre: fr ? "Le blanc" : "The white",
    note: fr ? "Assise, fond neutre." : "Seated, neutral background.",
  },
  {
    disposition: "decale",
    fichier: detail,
    alt: fr
      ? "Tee-shirt noir portant l’inscription « Fusion moderne, tradition fun », mannequin femme, fond orange"
      : "Black T-shirt lettered “Fusion moderne, tradition fun”, female model, orange background",
    format: "2 / 3",
    titre: fr ? "L’inscription" : "The lettering",
    note: fr
      ? "« Fusion moderne, tradition fun », peint sous l’illustration."
      : "“Fusion moderne, tradition fun”, painted below the illustration.",
  },
  {
    disposition: "large",
    fichier: cloture,
    alt: fr
      ? "Trois mannequins côte à côte portant trois tee-shirts de la collection, fond orange"
      : "Three models side by side wearing three T-shirts from the collection, orange background",
    format: "4 / 3",
    titre: fr ? "Clôture" : "Closing",
    note: fr ? "Les trois pièces réunies." : "The three pieces together.",
  },
] as const;
---

<Page
  titre={`${t("lookbook")} — Rakiire`}
  description={fr
    ? "La collection Ethnic Rakiire Classic en images."
    : "The Ethnic Rakiire Classic collection in pictures."}
  langue={langue}
  chemin={chemin}
>
  <EnteteEditoriale
    surtitre="Ethnic Rakiire Classic"
    titre="Lookbook"
    chapeau={fr
      ? "Les visuels de la première série, photographiés en studio sur fond orange."
      : "Visuals for the first series, shot in studio against an orange background."}
  />

  <div class="cadre planches">
    {
      plans.map((plan) => (
        <Revele class={`planche planche--${plan.disposition}`}>
          <div class="planche__visuel reserve-image" style={`aspect-ratio:${plan.format}`}>
            <Image
              src={plan.fichier}
              alt={plan.alt}
              widths={[480, 900, 1600]}
              sizes="(min-width: 48rem) 60vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="planche__legende">
            <p class="planche__titre">{plan.titre}</p>
            <p class="planche__note">{plan.note}</p>
          </div>
        </Revele>
      ))
    }
  </div>

  <div class="cadre fin">
    <Bouton variante="contour" href={lienBoutique(langue)}>{t("voirLaCollection")}</Bouton>
  </div>
</Page>

<style>
  .planches {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem) clamp(0.75rem, 0.25rem + 1.5vw, 1.5rem);
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  /* Chaque disposition occupe la grille différemment : c'est l'irrégularité qui
     distingue un lookbook d'une planche contact. */
  .planche--large { grid-column: 1 / -1; }
  .planche--paire { grid-column: span 1; }
  .planche--decale { grid-column: 1 / -1; }

  @media (min-width: 48rem) {
    .planche--decale {
      grid-column: 2 / -1;
      max-width: 30rem;
    }
  }

  .planche {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .planche__visuel {
    position: relative;
    width: 100%;
    background-color: var(--color-encre-08);
  }

  .planche__attente {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-legende);
    letter-spacing: var(--tracking-surtitre);
    text-transform: uppercase;
    color: var(--color-encre-45);
    text-align: center;
    padding-inline: 1rem;
  }

  .planche__legende {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .planche__titre {
    font-family: var(--font-titre);
    font-size: var(--text-t5);
  }

  .planche__note {
    font-size: var(--text-corps-s);
    color: var(--color-texte-tertiaire);
  }

  .fin {
    display: flex;
    justify-content: center;
    padding-bottom: var(--spacing-section);
  }
</style>
