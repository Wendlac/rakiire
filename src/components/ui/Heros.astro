---
/**
 * Héros plein cadre — Rakiire
 *
 * Motif commun aux références Merz b. Schwanen et Denim Tears : une photographie
 * occupe tout le cadre, le texte se cale dans un angle, rien ne flotte au milieu.
 *
 * Trois décisions portent ce composant :
 *
 * 1. La hauteur ne vaut jamais 100 % de la fenêtre. Un héros pleine hauteur
 *    chasse le reste de la page hors du premier écran et donne l'impression
 *    d'un site vide. On plafonne à 82 svh, ce qui laisse voir l'amorce de la
 *    section suivante et invite au défilement.
 *
 * 2. Le voile n'est pas une opinion. Sur une photo entièrement blanche, il faut
 *    0,50 d'opacité d'encre pour qu'un grand titre passe en AA et 0,62 pour du
 *    texte courant. Le dégradé retenu tient 0,68 sur toute la zone de texte.
 *
 * 3. `svh` plutôt que `vh` : sur mobile, la barre d'adresse fait varier `vh` et
 *    coupe le bas du héros au chargement.
 */
import { Image } from "astro:assets";

interface Props {
  image?: { fichier: ImageMetadata; alt: string };
  surtitre?: string;
  titre: string;
  texte?: string;
  /** Hauteur du cadre. « plein » pour une bannière de collection. */
  hauteur?: "moyen" | "plein";
  /** Position du bloc de texte. */
  ancrage?: "bas-gauche" | "bas-centre" | "centre";
  /**
   * Point d'ancrage du recadrage, passé tel quel à `object-position`.
   *
   * Le héros est large et la photographie ne l'est pas : `cover` rogne donc en
   * hauteur, et un recadrage centré coupe les visages quand les modèles sont
   * placés haut dans l'image. `center 22%` remonte la zone conservée.
   */
  cadrage?: string;
  /**
   * Comment le texte tient sur la photographie.
   *
   * `normal` — voile degrade. Suffisant sur une image sombre.
   * `clair`  — voile renforce. Pour une image claire derriere le texte ; la
   *            valeur par defaut n'y tient pas le contraste AA.
   * `panneau` — aucun voile, le texte est pose sur un bloc d'encre opaque.
   *
   * Le panneau n'est pas qu'une variante de gout. Un voile rend le contraste
   * dependant de la photographie : changer d'image oblige a remesurer, et
   * rien n'avertit quand ca ne passe plus. Un panneau opaque le rend
   * dependant de deux tokens — encre et texte-sur-image, 16.7:1 — donc
   * constant quelle que soit l'image. En echange, la photographie garde
   * toute sa clarte au lieu d'etre assombrie sur toute sa surface.
   */
  voile?: "normal" | "clair" | "panneau";
  /**
   * Niveau du titre. `h1` par defaut : sur une page reelle, le heros EST le
   * titre de la page. A abaisser quand un titre plus haut existe deja, pour ne
   * pas creer deux h1 dans un meme document.
   */
  niveau?: "h1" | "h2" | "p";
  class?: string;
}

const {
  image,
  surtitre,
  titre,
  texte,
  hauteur = "moyen",
  ancrage = "bas-gauche",
  cadrage = "center",
  voile = "normal",
  niveau: Titre = "h1",
  class: classe = "",
} = Astro.props;

const centre = ancrage === "centre";
const panneau = voile === "panneau";
---

<section
  class={`heros heros--${hauteur} heros--${ancrage} ${panneau ? "heros--panneau" : ""} sur-image ${classe}`}
>
  <div class="heros__image reserve-image" style={`--cadrage:${cadrage}`}>
    {
      image ? (
        <Image
          src={image.fichier}
          alt={image.alt}
          widths={[720, 1200, 1800]}
          sizes="100vw"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      ) : (
        <span class="heros__attente" aria-hidden="true">Visuel à venir</span>
      )
    }
  </div>

  {
    /* Aucun voile avec un panneau : c'est tout l'interet, la photographie
       reste a sa clarte d'origine. */
    !panneau && (
      <div
        class={`heros__voile ${centre ? "heros__voile--plein" : ""} ${voile === "clair" ? "heros__voile--clair" : ""}`}
        aria-hidden="true"
      />
    )
  }

  <div class="cadre heros__cadre">
    <div class="heros__contenu">
      {surtitre && <p class="surtitre">{surtitre}</p>}
      <Titre class="heros__titre">{titre}</Titre>
      {texte && <p class="heros__texte">{texte}</p>}
      <div class="heros__actions"><slot /></div>
    </div>
  </div>
</section>

<style>
  .heros {
    position: relative;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    overflow: hidden;
  }

  /* Jamais 100 svh : le premier écran doit laisser deviner la suite. */
  .heros--moyen { min-height: min(82svh, 46rem); }
  .heros--plein { min-height: min(92svh, 56rem); }

  .heros--centre { align-items: center; }

  .heros__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: var(--color-encre-80);
  }

  .heros__image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cadrage, center);
  }

  .heros__attente {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-legende);
    letter-spacing: var(--tracking-surtitre);
    text-transform: uppercase;
    color: var(--color-encre-45);
  }

  .heros__voile {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--voile-bas);
  }

  .heros__voile--clair {
    background: var(--voile-bas-clair);
  }

  /* Un contenu centre reclame un voile uniforme : il l'emporte sur le degrade. */
  .heros__voile--plein {
    background: var(--voile-plein);
  }

  .heros__cadre {
    width: 100%;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .heros__contenu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 34rem;
  }

  /* Le panneau. Opaque, donc le contraste ne depend plus de la photographie :
     texte-sur-image sur encre, 16.7:1, quelle que soit l'image placee derriere.
     Le padding est plus genereux que l'interligne ne l'exige — c'est le blanc
     autour du texte qui fait qu'un bloc pose sur une image se lit comme un
     choix et non comme un accident. */
  .heros--panneau .heros__contenu {
    background-color: var(--color-encre);
    padding: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
  }

  /* Sans voile, le bas de l'image n'est plus assombri : le panneau se decolle
     du bord pour ne pas donner l'impression d'une bande collee au cadre. */
  .heros--panneau .heros__cadre {
    padding-block: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
  }

  /* Le panneau est plus haut qu'un bloc de texte voile — il a ses propres
     marges interieures — et il masque donc une part plus grande du cadre.
     Un heros a la hauteur ordinaire lui ferait couper les visages : le bandeau
     est bien plus large que la photographie n'est haute, le recadrage mange
     donc deja le tiers de l'image, et ce qui reste au-dessus du panneau ne
     suffit plus. On lui donne de la hauteur pour que les visages passent
     au-dessus. */
  .heros--panneau.heros--moyen {
    min-height: min(92svh, 52rem);
  }

  .heros--bas-centre .heros__contenu,
  .heros--centre .heros__contenu {
    align-items: center;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }

  /* Le titre garde la serif meme quand il est rendu en <p> : le niveau change
     la semantique, jamais le dessin. */
  .heros__titre {
    margin: 0;
    font-family: var(--font-titre);
    font-weight: 400;
    font-size: var(--text-t1);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .heros__texte {
    font-size: var(--text-corps-l);
    max-width: 30rem;
  }

  .heros__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .heros__actions:empty { display: none; }
</style>
