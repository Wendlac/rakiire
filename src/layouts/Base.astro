---
/**
 * Gabarit de base — Rakiire
 *
 * Goudy Bookletter 1911 est servie par Google Fonts en attendant son
 * auto-hebergement : le preconnect vers fonts.gstatic.com economise un aller-
 * retour DNS + TLS, ce qui se sent immediatement sur un reseau mobile lent.
 */
import "../styles/global.css";

/* L'adresse finale des fontes, empreinte et racine de publication comprises,
   n'est connue qu'a la construction. On la demande a Vite plutot que de
   l'ecrire en dur : un chemin en dur casserait sous /rakiire/.
   Les deux fontes sont prechargees : elles portent tout le texte de la page,
   et les decouvrir apres la feuille de style provoquerait un rechargement
   visible du texte. L'italique de Satoshi n'est pas prechargee — elle ne se
   telecharge que si une page l'emploie. */
import satoshi from "../fonts/Satoshi-Variable.woff2?url";
import goudy from "../fonts/GoudyBookletter1911-Regular.woff2?url";

import { scriptAudience } from "../data/audience";

/* Aucune balise n'est ecrite tant que la mesure d'audience n'est pas
   configuree : voir src/data/audience.ts. */
const audience = scriptAudience();

interface Props {
  titre: string;
  description?: string;
  langue?: "fr" | "en";
}

const {
  titre,
  description = "Rakiire — Le choix d'être soi.",
  langue = "fr",
} = Astro.props;
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EEEEEE" />

    {/* Satoshi porte tout le texte courant : elle est prechargee pour que la
        premiere peinture se fasse deja dans la bonne fonte. L'italique n'est
        pas prechargee — elle ne se telecharge que si une page l'emploie. */}
    <link rel="preload" href={satoshi} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={goudy} as="font" type="font/woff2" crossorigin />

    {
      audience && (
        <script is:inline defer src={audience.src} {...audience.attributs} />
      )
    }
  </head>

  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
